{
  "name": "vigilant-hotel-web-pwa",
  "version": "1.0.0",
  "description": "Sistema de Gestão Hoteleira Vigilant Hotel - Web & PWA com SQLite e POO",
  "main": "backend/src/server.js",
  "type": "module",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
