{
  "name": "vigilant-hotel-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Gestão Hoteleira Vigilant Hotel - Monorepo Web & PWA com SQLite e POO",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run start --workspace=backend\" \"npm run start --workspace=frontend\"",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,green.bold\" \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "start:backend": "npm run start --workspace=backend",
    "start:frontend": "npm run start --workspace=frontend",
    "seed": "npm run seed --workspace=backend",
    "test": "npm run test --workspace=backend"
  },
  "keywords": [
    "pwa",
    "hotel",
    "poo",
    "sqlite",
    "monorepo",
    "workspaces"
  ],
  "author": "Equipe Vigilant Hotel",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
