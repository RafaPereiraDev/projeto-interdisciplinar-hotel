# Dependências
node_modules/

# Arquivos de ambiente e variáveis secretas
.env
.env.*
!.env.example

# Logs do sistema e npm
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs e configurações locais do desenvolvedor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.gemini/
.agents/

# Arquivos de sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# Banco de dados SQLite local em execução (o banco é gerado automaticamente na inicialização)
backend/src/database/*.db
backend/src/database/*.db-journal
backend/src/database/*.db-wal
backend/src/database/*.db-shm
